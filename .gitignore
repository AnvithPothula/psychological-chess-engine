# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Secrets -- never commit
.env
.env.*
!.env.example

# macOS
.DS_Store

# Trained checkpoints (reproducible via distill.py / train_dpo.py).
# Maia weights (models/*.pb.gz) are inputs and stay tracked.
*.pth

# Maia-2 checkpoint cache (273MB, auto-downloaded)
maia2_models/

# Run output: dumps, logs, caches, reports, screenshots. Everything here is
# regenerated by the scripts that write it, except the mined skew positions
# (hours of explorer calls) and the pipeline scripts that produced the results.
build/*
!build/skew_positions.jsonl
!build/*.sh
