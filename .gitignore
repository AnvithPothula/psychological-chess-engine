# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Secrets -- never commit
.env
.env.*
!.env.example

# macOS
.DS_Store

# Policy checkpoints. Their trainers were removed in the cleanup; recover them
# from git history to retrain.
*.pth

# Run output: dumps, logs, caches, reports, screenshots. Everything here is
# regenerated by the scripts that write it, except the mined skew positions
# (hours of explorer calls) and the pipeline scripts that produced the results.
build/*
!build/skew_positions.jsonl
!build/*.sh

# Maia-2 checkpoint cache, no longer used. Safe to delete.
maia2_models/
